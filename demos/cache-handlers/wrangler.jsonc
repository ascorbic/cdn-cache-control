{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cache-handlers-demo",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}